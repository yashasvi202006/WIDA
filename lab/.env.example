# Laboratory REST API Server
LAB_PORT=8082
LAB_HOST=127.0.0.1

# Frontend Vite Dev Server
VITE_LAB_PORT=5176
VITE_LAB_HOST=127.0.0.1

# JWT Secret Key (Use a high-entropy 256-bit key in production)
LAB_JWT_SECRET=your_secret_production_key_here

# Database Paths (Optional overrides; defaults to lab/database/lab.db)
LAB_DB_PATH=./database/lab.db
PATIENT_DB_PATH=../../src/modules/patient/backend/patient.db
